# Copy to .env and adjust. Never commit the .env file: it holds your API key.

# --- Paths on the Docker host -------------------------------------------------

# Local buffer. Keep this on fast local storage, not on the NAS.
SPOOL_PATH=./data/spool
# Small state directory: last-capture bookkeeping and the latest image mirror.
STATE_PATH=./data/state
# The mounted NFS share. Required.
ARCHIVE_PATH=/mnt/nas/timelapse

# Must match the numeric owner of the files on the NFS share.
# Find it with: stat -c '%u:%g' /mnt/nas/timelapse
PUID=1000
PGID=1000

# --- General ------------------------------------------------------------------

# Folder names are derived from local time, so set this explicitly.
TZ=Europe/Vienna
LOG_LEVEL=info
# text or json
LOG_FORMAT=text

# --- Camera -------------------------------------------------------------------

# "snapshot" uses the camera's own anonymous snapshot endpoint (needs
# "Anonymous Snapshot" enabled on the camera in UniFi Protect).
# "protect" uses the UniFi OS integration API and can return higher quality.
CAMERA_SOURCE=snapshot

# Required when CAMERA_SOURCE=snapshot.
CAMERA_SNAPSHOT_URL=http://camera.example.lan/snap.jpeg

# Required when CAMERA_SOURCE=protect.
# Create the key under Settings -> Control Plane -> Integrations.
# Find the camera id with: docker compose run --rm timelapse cameras
#PROTECT_HOST=https://unifi.example.lan
#PROTECT_API_KEY=
#PROTECT_CAMERA_ID=
#PROTECT_HIGH_QUALITY=true
# Enable only if the console presents a self-signed certificate.
#PROTECT_INSECURE_TLS=false

# Reject anything that is not a plausible JPEG, so an error page is never
# archived as an image.
MIN_IMAGE_BYTES=1024
CAMERA_TIMEOUT=20s
CAMERA_RETRIES=3
CAMERA_RETRY_DELAY=3s

# --- Capture ------------------------------------------------------------------

CAPTURE_ENABLED=true
CAPTURE_INTERVAL=5m
# Prefix for stored files: <prefix>YYYY-MM-DD-HH-MM-SS.jpg
FILENAME_PREFIX=snapshot_

# "fixed" uses ACTIVE_HOURS; "solar" derives the window from sunrise and sunset.
SCHEDULE_MODE=fixed
# Inclusive end hour, so 05-21 captures until 21:59 (matches cron's "5-21").
ACTIVE_HOURS=05-21

# Only used when SCHEDULE_MODE=solar.
#LATITUDE=48.2082
#LONGITUDE=16.3738
#SOLAR_DAWN_OFFSET=-30m
#SOLAR_DUSK_OFFSET=30m

# --- Archive sync -------------------------------------------------------------

# opportunistic: move each image right after capture, plus a nightly sweep.
# nightly:       only the nightly sweep.
# off:           never move anything; images stay in the spool.
SYNC_MODE=opportunistic
SYNC_AT=23:00

# The guard against writing into an unmounted mountpoint. This file must exist
# on the NAS share itself; if it is missing, the sync refuses to run and images
# keep buffering locally. Create it once with:
#   touch /mnt/nas/timelapse/.nas
ARCHIVE_SENTINEL=.nas
SYNC_PRUNE_EMPTY_DIRS=true

# --- Web interface ------------------------------------------------------------

WEB_ENABLED=true
WEB_PORT=8080
WEB_DEFAULT_LANGUAGE=en
WEB_ARCHIVE_ENABLED=true
WEB_LIVE_PREVIEW=true
WEB_LIVE_MIN_INTERVAL=2s
# Optional subtitle shown in the header.
#WEB_SITE_NAME=

# Leave empty for no authentication (LAN use). When set, open the UI once as
# http://host:8080/?token=<value> and the session cookie takes over.
#WEB_AUTH_TOKEN=

# Optional: serve translations from a mounted directory instead of the built-in
# ones, so a language can be added without rebuilding the image.
#WEB_I18N_DIR=/i18n

# --- Monitoring ---------------------------------------------------------------

METRICS_ENABLED=true
# Optional POST target for failure notifications (Home Assistant, ntfy, ...).
#NOTIFY_WEBHOOK_URL=
NOTIFY_FAILURE_THRESHOLD=3
NOTIFY_TIMEOUT=10s
