# Copy to .env and adjust. Never commit the .env file: it holds your API key.

# --- NAS / archive ------------------------------------------------------------

# Docker mounts the NFS share itself, so nothing needs to be in the host fstab.
NFS_HOST=nas.example.lan
NFS_PATH=/volume1/timelapse

# Must match the numeric owner of the files on the share.
PUID=1000
PGID=1000

# How often the archive service sweeps the local buffer onto the NAS.
SYNC_INTERVAL=60s

# The guard against writing into an unmounted mountpoint. This file must exist
# on the share itself; if it is missing the sync refuses to run and images keep
# buffering locally. Create it once:  touch /mnt/nas/timelapse/.nas
ARCHIVE_SENTINEL=.nas
SYNC_AT=23:00
SYNC_PRUNE_EMPTY_DIRS=true

# --- General ------------------------------------------------------------------

# Folder names are derived from local time, so set this explicitly.
TZ=Europe/Vienna
LOG_LEVEL=info
# text or json
LOG_FORMAT=text

# --- Camera -------------------------------------------------------------------

# Primary source.
#   snapshot  the camera's own anonymous endpoint (needs "Anonymous Snapshot"
#             enabled on the camera in UniFi Protect)
#   protect   the UniFi OS integration API, which can return higher quality
CAMERA_SOURCE=protect

# Optional fallback, tried whenever the primary fails. Leave empty for none.
# The primary is retried on every capture, so recovery is automatic.
CAMERA_FALLBACK_SOURCE=snapshot

# Used by the snapshot source.
CAMERA_SNAPSHOT_URL=http://camera.example.lan/snap.jpeg

# Used by the protect source. Create the key under
# Settings -> Control Plane -> Integrations.
# Find the camera id with: docker compose run --rm timelapse cameras
PROTECT_HOST=https://unifi.example.lan
PROTECT_API_KEY=
PROTECT_CAMERA_ID=
PROTECT_HIGH_QUALITY=true
# Enable only if the console presents a self-signed certificate.
PROTECT_INSECURE_TLS=false

# Reject anything that is not a plausible JPEG, so an error page is never
# archived as an image.
MIN_IMAGE_BYTES=1024
CAMERA_TIMEOUT=20s
CAMERA_RETRIES=3
CAMERA_RETRY_DELAY=3s

# --- Capture ------------------------------------------------------------------

CAPTURE_ENABLED=true
CAPTURE_INTERVAL=5m
# Prefix for stored files: <prefix>YYYY-MM-DD-HH-MM-SS.jpg
FILENAME_PREFIX=snapshot_

# "fixed" uses ACTIVE_HOURS; "solar" derives the window from sunrise and sunset.
SCHEDULE_MODE=fixed
# Inclusive end hour, so 05-21 captures until 21:59 (matches cron's "5-21").
ACTIVE_HOURS=05-21

# Only used when SCHEDULE_MODE=solar.
#LATITUDE=48.2082
#LONGITUDE=16.3738
#SOLAR_DAWN_OFFSET=-30m
#SOLAR_DUSK_OFFSET=30m

# --- Monitoring ---------------------------------------------------------------

# The watchdog: probes the camera and checks how fresh the archive is, without
# writing anything. Defaults on where capturing is off.
#MONITOR_ENABLED=
MONITOR_INTERVAL=5m
# How stale the newest archived image may become before reporting unhealthy.
# Empty derives it from the capture interval.
#ARCHIVE_MAX_AGE=15m

# A camera can answer with the same frame forever. This many byte-identical
# frames in a row is treated as a frozen camera. 0 disables the check.
FROZEN_FRAME_THRESHOLD=3

METRICS_ENABLED=true
# Optional POST target for failure notifications (Home Assistant, ntfy, ...).
#NOTIFY_WEBHOOK_URL=
NOTIFY_FAILURE_THRESHOLD=3
NOTIFY_TIMEOUT=10s

# --- Web interface ------------------------------------------------------------

WEB_ENABLED=true
WEB_PORT=8099
WEB_DEFAULT_LANGUAGE=en
WEB_ARCHIVE_ENABLED=true
WEB_LIVE_PREVIEW=true
WEB_LIVE_MIN_INTERVAL=2s
WEB_ZIP_ENABLED=true
# Optional subtitle shown in the header.
#WEB_SITE_NAME=

# none | local | ingress. Empty means local when a token is set, otherwise none.
#WEB_AUTH_MODE=
# Open the UI once as http://host:8099/?token=<value>; a cookie takes over.
#WEB_AUTH_TOKEN=

# Optional: serve translations from a mounted directory instead of the built-in
# ones, so a language can be added without rebuilding the image.
#WEB_I18N_DIR=/i18n

# --- Video --------------------------------------------------------------------

VIDEO_ENABLED=true
VIDEO_FPS=12
# 0 is lossless, 51 is worst. 23 is a sensible default.
VIDEO_CRF=23
VIDEO_MAX_FRAMES=5000
VIDEO_TIMEOUT=10m
